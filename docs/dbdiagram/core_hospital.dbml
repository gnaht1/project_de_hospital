  phan_loai_nb_id string [note: "ID phân loại người bệnh"]
  quoc_tich_id int [note: "ID quốc tịch của người bệnh"]
  so_bao_hiem_xa_hoi string [note: "Số bảo hiểm xã hội"]
  so_dien_thoai string [note: "Số điện thoại liên hệ của người bệnh"]
  so_ngay_dieu_tri int [note: "Tổng số ngày điều trị"]
  so_phoi string [note: "Số phôi (nếu có liên quan điều trị sinh sản)"]
  ten_nb string [note: "Tên đầy đủ người bệnh"]
  ten_nb_khong_dau string [note: "Tên người bệnh không dấu (phục vụ tìm kiếm)"]
  thoi_gian_lap_benh_an string [note: "Thời gian lập bệnh án"]
  thoi_gian_ra_vien string [note: "Thời gian ra viện"]
  thoi_gian_vao_vien string [note: "Thời gian vào viện"]
  tiem_chung boolean [note: "Cờ xác định có tiêm chủng"]
  trang_thai int [note: "Trạng thái đợt điều trị"]
  uu_tien boolean [note: "Cờ ưu tiên (VIP / ưu tiên khám chữa bệnh)"]
  duyet_chi_phi string [note: "Trạng thái duyệt chi phí"]
  bang_lai_xe_id string [note: "ID bằng lái xe (nếu có)"]
  ma_doi_tuong_kcb_id string [note: "Mã đối tượng khám chữa bệnh"]
  nhan_vien_kinh_doanh_id string [note: "ID nhân viên kinh doanh phụ trách"]
  can_nang_vao_vien string [note: "Cân nặng người bệnh khi vào viện"]
  cong_ty_bao_hiem_id string [note: "ID công ty bảo hiểm"]
  phan_loai_doi_tuong float [note: "Phân loại đối tượng người bệnh"]
  nguoi_duyet_chi_phi_id string [note: "ID người duyệt chi phí"]
  nguoi_gui_duyet_chi_phi_id string [note: "ID người gửi duyệt chi phí"]
  nguoi_tu_choi_duyet_chi_phi_id string [note: "ID người từ chối duyệt chi phí"]
  loai_lien_ket string [note: "Loại liên kết người bệnh"]
  nb_lien_ket_id string [note: "ID người bệnh liên kết"]
  ho_ngheo boolean [note: "Cờ xác định người bệnh thuộc hộ nghèo"]
  active boolean [note: "Trạng thái hiệu lực của bản ghi"]
  deleted int [note: "Cờ xóa logic (soft delete): 0 = chưa xóa, 1 = đã xóa"]
