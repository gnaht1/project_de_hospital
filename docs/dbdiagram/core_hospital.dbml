// Table 1: ct_address
Table ct_address [note: "Bảng lưu thông tin địa chỉ cư trú, tạm trú và địa chỉ công ty của người bệnh theo từng đợt điều trị"] {
  nb_dot_dieu_tri_id int [note: "ID đợt điều trị của người bệnh (FK)"]
  so_nha string [note: "Số nhà theo địa chỉ thường trú"]
  so_nha_tam_tru string [note: "Số nhà theo địa chỉ tạm trú"]
  xa_phuong_id float [note: "ID xã/phường theo địa chỉ thường trú (FK)"]
  xa_phuong_tam_tru_id string [note: "ID xã/phường theo địa chỉ tạm trú (FK)"]
  quan_huyen_id float [note: "ID quận/huyện theo địa chỉ thường trú (FK)"]
  quan_huyen_tam_tru_id string [note: "ID quận/huyện theo địa chỉ tạm trú (FK)"]
  tinh_thanh_pho_id float [note: "ID tỉnh/thành phố theo địa chỉ thường trú (FK)"]
  tinh_thanh_pho_tam_tru_id string [note: "ID tỉnh/thành phố theo địa chỉ tạm trú (FK)"]
  dia_chi_cong_ty string [note: "Địa chỉ công ty nơi người bệnh làm việc"]
  ten_cong_ty string [note: "Tên công ty nơi người bệnh làm việc"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

