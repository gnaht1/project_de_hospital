// Table 4: ct_dot_dieu_tri
Table ct_dot_dieu_tri [note: "Bảng trung tâm lưu thông tin đợt điều trị của người bệnh, bao gồm thông tin hành chính, phân loại, thời gian điều trị và trạng thái hồ sơ"] {
  id int [pk, note: "Khóa chính của bảng, định danh duy nhất mỗi đợt điều trị"]
  cap_cuu boolean [note: "Flag xác định đợt điều trị cấp cứu"]
  chi_nam_sinh boolean [note: "Flag cho biết chỉ có thông tin năm sinh (không có ngày/tháng sinh)"]
  dan_toc_id float [note: "ID dân tộc của người bệnh"]
  doi_tuong int [note: "Đối tượng người bệnh (theo phân loại nội bộ)"]
  doi_tuong_kcb int [note: "Đối tượng khám chữa bệnh(FK)"]
  gioi_tinh int [note: "Giới tính người bệnh"]
  kham_suc_khoe boolean [note: "Flag xác định đợt khám sức khỏe"]
  khoa_id int [note: "ID khoa điều trị hiện tại(FK)"]
  khoa_tiep_don_id int [note: "ID khoa tiếp đón ban đầu(FK)"]
  loai_benh_an_id string [note: "Loại bệnh án"]
  loai_doi_tuong_id float [note: "ID loại đối tượng người bệnh"]
  ma_benh_an string [note: "Mã bệnh án"]
  ma_ho_so int [note: "Mã hồ sơ"]
  ma_nb int [note: "Mã người bệnh"]
  mac_dinh boolean [note: "Flag đánh dấu đợt điều trị mặc định"]
  nb_thong_tin_id int [note: "ID bảng thông tin người bệnh (foreign key)"]
  ngay_sinh string [note: "Ngày sinh người bệnh (định dạng string theo dữ liệu nguồn)"]
  nghe_nghiep_id string [note: "ID nghề nghiệp của người bệnh"]
  ngoai_vien boolean [note: "Flag xác định người bệnh ngoại viện"]
  nguoi_lap_benh_an_id string [note: "ID người lập bệnh án"]
  nhom_mau string [note: "Nhóm máu của người bệnh"]
  noi_lam_viec string [note: "Nơi làm việc của người bệnh"]
  phan_loai_nb_id string [note: "ID phân loại người bệnh"]
  quoc_tich_id int [note: "ID quốc tịch của người bệnh"]
  so_bao_hiem_xa_hoi string [note: "Số bảo hiểm xã hội"]
  so_dien_thoai string [note: "Số điện thoại liên hệ của người bệnh"]
  so_ngay_dieu_tri int [note: "Tổng số ngày điều trị"]
  so_phoi string [note: "Số phôi (nếu có liên quan điều trị sinh sản)"]
  ten_nb string [note: "Tên đầy đủ người bệnh"]
  ten_nb_khong_dau string [note: "Tên người bệnh không dấu (phục vụ tìm kiếm)"]
  thoi_gian_lap_benh_an string [note: "Thời gian lập bệnh án"]
  thoi_gian_ra_vien string [note: "Thời gian ra viện"]
  thoi_gian_vao_vien string [note: "Thời gian vào viện"]
  tiem_chung boolean [note: "Flag xác định có tiêm chủng"]
  trang_thai int [note: "Trạng thái đợt điều trị"]
  uu_tien boolean [note: "Flag ưu tiên (VIP / ưu tiên khám chữa bệnh)"]
  duyet_chi_phi string [note: "Trạng thái duyệt chi phí"]
  bang_lai_xe_id string [note: "ID bằng lái xe (nếu có)"]
  ma_doi_tuong_kcb_id string [note: "Mã đối tượng khám chữa bệnh"]
  nhan_vien_kinh_doanh_id string [note: "ID nhân viên kinh doanh phụ trách"]
  can_nang_vao_vien string [note: "Cân nặng người bệnh khi vào viện"]
  cong_ty_bao_hiem_id string [note: "ID công ty bảo hiểm"]
  phan_loai_doi_tuong float [note: "Phân loại đối tượng người bệnh"]
  nguoi_duyet_chi_phi_id string [note: "ID người duyệt chi phí"]
  nguoi_gui_duyet_chi_phi_id string [note: "ID người gửi duyệt chi phí"]
  nguoi_tu_choi_duyet_chi_phi_id string [note: "ID người từ chối duyệt chi phí"]
  loai_lien_ket string [note: "Loại liên kết người bệnh"]
  nb_lien_ket_id string [note: "ID người bệnh liên kết"]
  ho_ngheo boolean [note: "Flag xác định người bệnh thuộc hộ nghèo"]
  active boolean [note: "Trạng thái hiệu lực của bản ghi"]
  deleted int [note: "Flag xóa logic (soft delete): 0 = chưa xóa, 1 = đã xóa"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

