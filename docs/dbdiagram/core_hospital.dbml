// Table 31: hospital_configs
Table hospital_configs [note: "Bảng lưu trữ cấu hình hệ thống, tham số tùy chỉnh cho các bảng và cột dữ liệu"] {
  id int [pk, note: "Khóa chính: ID định danh cấu hình"]
