  thoi_gian_huy_thanh_toan datetime [note: "Thời gian hủy thanh toán"]
  thoi_gian_thanh_toan string [note: "Thời gian thực hiện thanh toán"]
  thu_ngan_huy_thanh_toan_id float [note: "ID thu ngân thực hiện hủy thanh toán"]
  thu_ngan_id float [note: "ID thu ngân thực hiện thu tiền"]
  tien_bh_thanh_toan float [note: "Số tiền bảo hiểm thanh toán"]
  tien_bh_thanh_toan_trong_goi float [note: "Số tiền bảo hiểm thanh toán trong gói"]
  tien_giam_gia float [note: "Tổng số tiền giảm giá"]
  tien_hoan_tra float [note: "Số tiền hoàn trả cho người bệnh"]
  tien_mien_giam_dich_vu float [note: "Số tiền miễn giảm theo dịch vụ"]
  tien_mien_giam_phieu_thu float [note: "Số tiền miễn giảm trên phiếu thu"]
  tien_mien_giam_phieu_thu_nhap_vao float [note: "Số tiền miễn giảm phiếu thu được nhập vào"]
  tien_nb_cung_chi_tra float [note: "Số tiền người bệnh cùng chi trả"]
  tien_nb_cung_chi_tra_trong_goi float [note: "Số tiền người bệnh cùng chi trả trong gói"]
  tien_nb_phu_thu float [note: "Số tiền phụ thu người bệnh"]
  tien_nb_tu_tra float [note: "Số tiền người bệnh tự trả"]
  tien_nguon_khac float [note: "Số tiền từ các nguồn khác"]
  tien_tai_tro_bao_hiem float [note: "Số tiền tài trợ bảo hiểm"]
  tien_tai_tro_khong_bao_hiem float [note: "Số tiền tài trợ không qua bảo hiểm"]
  trang_thai_hoa_don int [note: "Trạng thái hóa đơn"]
  hoan_ung boolean [note: "Cờ xác định hoàn ứng"]
  loai_mien_giam string [note: "Loại miễn giảm áp dụng"]
  phieu_doi_tra_id string [note: "ID phiếu đổi/trả liên quan"]
  thoi_gian_tao_phieu string [note: "Thời gian tạo phiếu thu"]
  thoi_gian_cap_nhat_phieu string [note: "Thời gian cập nhật phiếu thu"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}










