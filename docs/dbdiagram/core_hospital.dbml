  description string [note: "Mô tả chi tiết ý nghĩa và tác dụng của cấu hình này"]
  created_at timestamp [note: "Thời điểm tạo bản ghi"]
  updated_at timestamp [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

