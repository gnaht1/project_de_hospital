// Table 6: ct_dv_kham_ket_luan
Table ct_dv_kham_ket_luan [note: "Bảng lưu thông tin kết luận khám bệnh và định hướng điều trị cho người bệnh theo từng đợt điều trị"] {
  id int [pk, note: "Khóa chính của bảng, định danh duy nhất mỗi bản ghi kết luận khám"]
  nb_dot_dieu_tri_id int [note: "ID đợt điều trị của người bệnh (foreign key)"]
