// Table 1: ct_address
Table ct_address [note: "Bảng lưu thông tin địa chỉ cư trú, tạm trú và địa chỉ công ty của người bệnh theo từng đợt điều trị"] {
  nb_dot_dieu_tri_id int [note: "ID đợt điều trị của người bệnh (foreign key)"]
  so_nha string [note: "Số nhà theo địa chỉ thường trú"]
  so_nha_tam_tru string [note: "Số nhà theo địa chỉ tạm trú"]
  xa_phuong_id float [note: "ID xã/phường theo địa chỉ thường trú"]
  xa_phuong_tam_tru_id string [note: "ID xã/phường theo địa chỉ tạm trú"]
  quan_huyen_id float [note: "ID quận/huyện theo địa chỉ thường trú"]
  quan_huyen_tam_tru_id string [note: "ID quận/huyện theo địa chỉ tạm trú"]
  tinh_thanh_pho_id float [note: "ID tỉnh/thành phố theo địa chỉ thường trú"]
  tinh_thanh_pho_tam_tru_id string [note: "ID tỉnh/thành phố theo địa chỉ tạm trú"]
  dia_chi_cong_ty string [note: "Địa chỉ công ty nơi người bệnh làm việc"]
  ten_cong_ty string [note: "Tên công ty nơi người bệnh làm việc"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

// Table 2: ct_bo_chi_dinh
Table ct_bo_chi_dinh [note: "Bảng lưu thông tin các bộ chỉ định được áp dụng cho từng đợt điều trị của người bệnh"] {
  id int [pk, note: "Khóa chính của bảng, định danh duy nhất mỗi bản ghi"]
  nb_dot_dieu_tri_id int [note: "ID đợt điều trị của người bệnh (foreign key tới bảng đợt điều trị)"]
  bo_chi_dinh_id int [note: "ID bộ chỉ định (foreign key tới danh mục bộ chỉ định)"]
  thoi_gian_chi_dinh string [note: "Thời gian chỉ định (định dạng string theo dữ liệu nguồn)"]
  active boolean [note: "Trạng thái hiệu lực của bản ghi: true = đang hoạt động"]
  deleted int [note: "Cờ xóa logic (soft delete): 0 = chưa xóa, 1 = đã xóa"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

