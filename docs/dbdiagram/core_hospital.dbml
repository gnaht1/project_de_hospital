  ket_qua_dieu_tri float [note: "Kết quả điều trị"]
  loi_dan string [note: "Lời dặn của bác sĩ dành cho người bệnh"]
  phong_hen_kham_id float [note: "ID phòng hẹn khám / tái khám"]
  so_ngay_cho_don float [note: "Số ngày chờ đón / theo dõi"]
  thoi_gian_hen_tai_kham string [note: "Thời gian hẹn tái khám"]
  thoi_gian_ket_luan string [note: "Thời gian kết luận khám"]
  so_hen_kham string [note: "Số hẹn khám"]
  thong_tin_theo_doi string [note: "Thông tin theo dõi sau khám"]
  den_ngay string [note: "Ngày kết thúc thời gian theo dõi"]
  tu_ngay string [note: "Ngày bắt đầu thời gian theo dõi"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

