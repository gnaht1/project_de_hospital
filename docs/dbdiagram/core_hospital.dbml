  bac_si_kham_id float [note: "ID bác sĩ trực tiếp khám (FK)"]
  dot_kham_moi boolean [note: "Flag xác định đây là đợt khám mới"]
  nguoi_phien_dich_id string [note: "ID người phiên dịch (nếu có)"]
  stt_chuyen_khoa string [note: "Số thứ tự khám theo chuyên khoa"]
  thiet_lap string [note: "Thiết lập/ghi chú liên quan đến dịch vụ khám"]
  thoi_gian_kham string [note: "Thời gian bắt đầu khám"]
  thoi_gian_ket_luan string [note: "Thời gian kết luận khám"]
  active boolean [note: "Trạng thái hiệu lực của bản ghi"]
  deleted int [note: "Flag xóa logic (soft delete): 0 = chưa xóa, 1 = đã xóa"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

