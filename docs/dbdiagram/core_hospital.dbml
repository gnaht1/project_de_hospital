// Table 2: ct_bo_chi_dinh
Table ct_bo_chi_dinh [note: "Bảng lưu thông tin các bộ chỉ định được áp dụng cho từng đợt điều trị của người bệnh"] {
  id int [pk, note: "Khóa chính của bảng, định danh duy nhất mỗi bản ghi"]
  nb_dot_dieu_tri_id int [note: "ID đợt điều trị của người bệnh (foreign key tới bảng đợt điều trị)"]
  bo_chi_dinh_id int [note: "ID bộ chỉ định (foreign key tới danh mục bộ chỉ định)"]
  thoi_gian_chi_dinh string [note: "Thời gian chỉ định"]
  active boolean [note: "Trạng thái hiệu lực của bản ghi: true = đang hoạt động"]
  deleted int [note: "Flag xóa logic (soft delete): 0 = chưa xóa, 1 = đã xóa"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

Ref: ct_bo_chi_dinh.nb_dot_dieu_tri_id > ct_dot_dieu_tri.id
Ref: ct_bo_chi_dinh.bo_chi_dinh_id > dm_bo_chi_dinh.id

// Table 3: ct_dich_vu
Table ct_dich_vu [note: "Bảng chi tiết dịch vụ (thuốc, vật tư, CLS...) được chỉ định cho người bệnh"] {
  // --- Khóa & Định danh ---
  id int [pk, note: "Khóa chính"]
  nb_dot_dieu_tri_id int [note: "Khóa ngoại: Liên kết với đợt điều trị của người bệnh"]
  nb_bo_chi_dinh_id int [note: "Khóa ngoại: Liên kết với bộ chỉ định (nếu có)"]
  dich_vu_id int [note: "Khóa ngoại: Liên kết với danh mục dịch vụ (dm_dich_vu)"]
  
  // --- Hành chính & Phân loại ---
  bac_si_chi_dinh_id int [note: "Khóa ngoại: ID bác sĩ chỉ định"]
  khoa_chi_dinh_id int [note: "Khóa ngoại: ID khoa chỉ định"]
  doi_tuong_kcb int [note: "Khóa ngoại: Đối tượng bệnh nhân tại thời điểm chỉ định"]
  loai_doi_tuong_id int [note: "Khóa ngoại: Phân loại chi tiết đối tượng"]
  loai_dich_vu int [note: "Khóa ngoại: Loại dịch vụ (Ví dụ: Khám, XN, X-Quang)"]
  nb_chuyen_khoa_id int [note: "ID chuyên khoa của người bệnh"]
  
  // --- Nguồn & Theo dõi ---
  chi_dinh_tu_dich_vu_id int [note: "ID dịch vụ nguồn đã kích hoạt chỉ định này (Đệ quy hoặc tham chiếu chéo)"]
  chi_dinh_tu_loai_dich_vu int [note: "Loại của dịch vụ nguồn"]
  stt_hien_thi int [note: "Số thứ tự hiển thị"]
  ghi_chu string [note: "Ghi chú lâm sàng hoặc hướng dẫn"]
  
  // --- Tài chính: Giá cả ---
  gia_bao_hiem float [note: "Đơn giá bảo hiểm chi trả"]
  gia_goc float [note: "Giá gốc của dịch vụ"]
  gia_khong_bao_hiem float [note: "Đơn giá thu phí (đối tượng không BHYT)"]
  gia_phu_thu float [note: "Số tiền phụ thu"]
  dv_gia_id int [note: "ID cấu hình giá cụ thể được áp dụng"]
  
  // --- Tài chính: Thanh toán & Tính toán ---
  so_luong float [note: "Số lượng chỉ định"]
  thanh_toan int [note: "Trạng thái thanh toán (0: Chưa, 1: Đã thanh toán)"]
  phieu_thu_id int [note: "Khóa ngoại: ID phiếu thu tiền"]
  phat_hanh_hoa_don boolean [note: "Flag: Trạng thái đã xuất hóa đơn"]
  loai_hinh_thanh_toan_id int [note: "ID hình thức thanh toán"]
  
  // --- Tài chính: Miễn giảm & Ngoại lệ ---
  khong_thu_tien boolean [note: "Flag: Không thu tiền dịch vụ này"]
  khong_tinh_tien boolean [note: "Flag: Không tính tiền (Miễn phí hoàn toàn)"]
  mien_cung_chi_tra boolean [note: "Flag: Miễn phần cùng chi trả"]
  muc_huong float [note: "Mức hưởng bảo hiểm (%)"]
  
  // Chi tiết tiền giảm giá/miễn giảm
  phan_tram_mien_giam_dich_vu_bh float [note: "% miễn giảm trên phần BHYT chi trả"]
  phan_tram_mien_giam_dich_vu_khong_bh float [note: "% miễn giảm trên phần không BHYT"]
  tien_giam_gia_bh float [note: "Số tiền giảm giá trên phần BHYT"]
  tien_giam_gia_khong_bh float [note: "Số tiền giảm giá trên phần không BHYT"]
  tien_mien_giam_dich_vu_bh float [note: "Số tiền miễn giảm trên phần BHYT"]
  tien_mien_giam_dich_vu_khong_bh float [note: "Số tiền miễn giảm trên phần không BHYT"]
  tien_mien_giam_dich_vu_nhap_vao float [note: "Số tiền miễn giảm nhập tay trực tiếp"]
  tien_mien_giam_phieu_thu_bh float [note: "Tiền miễn giảm phiếu thu phân bổ vào phần BHYT"]
  tien_mien_giam_phieu_thu_khong_bh float [note: "Tiền miễn giảm phiếu thu phân bổ vào phần không BHYT"]
  
  // Chi tiết số tiền thanh toán cuối cùng
  tien_bh_thanh_toan float [note: "Số tiền Bảo hiểm thanh toán"]
  tien_nb_cung_chi_tra float [note: "Số tiền người bệnh cùng chi trả"]
  tien_nb_phu_thu float [note: "Số tiền người bệnh trả phụ thu"]
  tien_nb_trai_tuyen float [note: "Số tiền người bệnh trả trái tuyến"]
  tien_nb_tu_tra float [note: "Số tiền người bệnh tự trả hoàn toàn"]
  tien_nguon_khac float [note: "Số tiền từ nguồn khác chi trả"]
  
  // Tỷ lệ
  ty_le_bh_tt float [note: "Tỷ lệ bảo hiểm thanh toán"]
  ty_le_tt_dv float [note: "Tỷ lệ thanh toán theo dịch vụ"]
  
  // --- Thời gian ---
  thoi_gian_chi_dinh datetime [note: "Thời gian chỉ định"]
  thoi_gian_thuc_hien datetime [note: "Thời gian thực hiện"]
  
  // --- Bên ngoài & Gói ---
  ngoai_vien boolean [note: "Flag: Dịch vụ thực hiện ngoại viện"]
  ngoai_vien_id int [note: "ID đơn vị ngoại viện"]
  nguon_khac_id int [note: "ID nguồn tài trợ khác"]
  nb_goi_dv_chi_tiet_id int [note: "Liên kết chi tiết gói dịch vụ"]
  nb_goi_pt_tt_id int [note: "Liên kết gói Phẫu thuật thủ thuật"]
  nb_the_bao_hiem_id int [note: "Liên kết thẻ bảo hiểm người bệnh"]
  nb_phac_do_dieu_tri_id int [note: "Liên kết phác đồ điều trị"]
  phac_do_dieu_tri_dich_vu_id int [note: "Liên kết dịch vụ trong phác đồ"]
  
  // --- Trạng thái & Hệ thống ---
  phieu_doi_tra_id int [note: "Liên kết phiếu đổi trả (nếu có hoàn trả)"]
  trang_thai_hoan int [note: "Trạng thái hoàn tiền"]
  tu_tra boolean [note: "Flag: Bệnh nhân tự chi trả"]
  dung_tuyen boolean [note: "Flag: Đúng tuyến bảo hiểm"]
  
  active boolean [note: "Trạng thái hoạt động của bản ghi"]
  deleted int [note: "Flag xóa mềm (0: Chưa xóa, 1: Đã xóa)"]
  created_at datetime [note: "Thời điểm tạo bản ghi"]
  updated_at datetime [note: "Thời điểm cập nhật bản ghi gần nhất"]
}

Ref: ct_dich_vu.nb_dot_dieu_tri_id > ct_dot_dieu_tri.id
Ref: ct_dich_vu.dich_vu_id > dm_dich_vu.id
Ref: ct_dich_vu.nb_bo_chi_dinh_id > ct_bo_chi_dinh.id
Ref: ct_dich_vu.bac_si_chi_dinh_id > dm_nhan_vien.id
Ref: ct_dich_vu.khoa_chi_dinh_id > dm_khoa.id
Ref: ct_dich_vu.phieu_thu_id > ct_phieu_thu.id
