<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SyncFlow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_Sync">
    <bpmn:participant id="Participant_DataSync" name="Data Synchronization (PostgreSQL to Kafka)" processRef="Process_DataSync" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DataSync" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sync">
      <bpmn:lane id="Lane_PostgreSQL" name="Core Hospital DB (PostgreSQL)">
        <bpmn:flowNodeRef>StartEvent_TxCommit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteWAL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Debezium" name="CDC Connector (Debezium)">
        <bpmn:flowNodeRef>Task_ReadWAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransformEvent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kafka" name="Kafka Cluster">
        <bpmn:flowNodeRef>EndEvent_DataInTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishMessage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Postgres Flows -->
    <bpmn:startEvent id="StartEvent_TxCommit" name="Transaction Committed">
      <bpmn:outgoing>Flow_ToWAL</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_WriteWAL" name="Write to Write-Ahead Log (WAL)">
      <bpmn:incoming>Flow_ToWAL</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDebezium</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Debezium Flows -->
    <bpmn:task id="Task_ReadWAL" name="Read WAL Entries">
      <bpmn:incoming>Flow_ToDebezium</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTransform</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TransformEvent" name="Construct Change Event Message">
      <bpmn:incoming>Flow_ToTransform</bpmn:incoming>
      <bpmn:outgoing>Flow_ToKafka</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Kafka Flows -->
    <bpmn:task id="Task_PublishMessage" name="Persist to Topic">
      <bpmn:incoming>Flow_ToKafka</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_DataInTopic" name="Data Available in Kafka">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_ToWAL" sourceRef="StartEvent_TxCommit" targetRef="Task_WriteWAL" />
    <bpmn:sequenceFlow id="Flow_ToDebezium" sourceRef="Task_WriteWAL" targetRef="Task_ReadWAL" />
    <bpmn:sequenceFlow id="Flow_ToTransform" sourceRef="Task_ReadWAL" targetRef="Task_TransformEvent" />
    <bpmn:sequenceFlow id="Flow_ToKafka" sourceRef="Task_TransformEvent" targetRef="Task_PublishMessage" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_PublishMessage" targetRef="EndEvent_DataInTopic" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Sync">
      <bpmndi:BPMNShape id="Participant_DataSync_di" bpmnElement="Participant_DataSync" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="900" height="400" />
      </bpmndi:BPMNShape>
      
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_PostgreSQL_di" bpmnElement="Lane_PostgreSQL" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="870" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Debezium_di" bpmnElement="Lane_Debezium" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="870" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kafka_di" bpmnElement="Lane_Kafka" isHorizontal="true">
        <dc:Bounds x="190" y="340" width="870" height="140" />
      </bpmndi:BPMNShape>
      
      <!-- Nodes -->
      <bpmndi:BPMNShape id="StartEvent_TxCommit_di" bpmnElement="StartEvent_TxCommit">
        <dc:Bounds x="252" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="238" y="165" width="65" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriteWAL_di" bpmnElement="Task_WriteWAL">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadWAL_di" bpmnElement="Task_ReadWAL">
        <dc:Bounds x="350" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransformEvent_di" bpmnElement="Task_TransformEvent">
        <dc:Bounds x="550" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublishMessage_di" bpmnElement="Task_PublishMessage">
        <dc:Bounds x="550" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DataInTopic_di" bpmnElement="EndEvent_DataInTopic">
        <dc:Bounds x="752" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="736" y="435" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_ToWAL_di" bpmnElement="Flow_ToWAL"><di:waypoint x="288" y="140" /><di:waypoint x="350" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDebezium_di" bpmnElement="Flow_ToDebezium"><di:waypoint x="400" y="180" /><di:waypoint x="400" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTransform_di" bpmnElement="Flow_ToTransform"><di:waypoint x="450" y="270" /><di:waypoint x="550" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToKafka_di" bpmnElement="Flow_ToKafka"><di:waypoint x="600" y="310" /><di:waypoint x="600" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd"><di:waypoint x="650" y="410" /><di:waypoint x="752" y="410" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
