<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HospitalProject" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.16.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_HospitalMain">
    <bpmn:participant id="Participant_Hospital" name="Hospital Core Process" processRef="Process_Hospital_Unified" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hospital_Unified" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Roles">
      <bpmn:lane id="Lane_Receptionist" name="Receptionist / Admin">
        <bpmn:flowNodeRef>StartEvent_PatientArrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignQueue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Doctor" name="Doctor / Physician">
        <bpmn:flowNodeRef>Task_ClinicalExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedsServices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderServices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalConclusion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Technician" name="Technician (Lab/X-Ray)">
        <bpmn:flowNodeRef>Task_ExecuteService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cashier" name="Cashier / Finance">
        <bpmn:flowNodeRef>Task_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PatientDischarged</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_PatientArrives" name="Patient Arrives">
      <bpmn:outgoing>Flow_To_Register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegisterPatient" name="Register Patient &amp; Create Visit">
      <bpmn:documentation>RELATED TABLES:
1. dm_benh_nhan: Lookup existing patient or create new permanent patient ID.
2. ct_dot_dieu_tri: [CRITICAL] Create new visit session ID (start time, insurance status).
3. ct_address: Update current contact address for this visit.</bpmn:documentation>
      <bpmn:incoming>Flow_To_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Assign</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Register" sourceRef="StartEvent_PatientArrives" targetRef="Task_RegisterPatient" />
    <bpmn:userTask id="Task_AssignQueue" name="Assign to Clinic Queue">
      <bpmn:documentation>RELATED TABLES:
1. ct_dv_kham: Create initial clinical service record (queuing for specific clinic/doctor).</bpmn:documentation>
      <bpmn:incoming>Flow_To_Assign</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Exam</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Assign" sourceRef="Task_RegisterPatient" targetRef="Task_AssignQueue" />
    <bpmn:sequenceFlow id="Flow_To_Exam" sourceRef="Task_AssignQueue" targetRef="Task_ClinicalExam" />
    <bpmn:userTask id="Task_ClinicalExam" name="Perform Clinical Examination">
      <bpmn:documentation>RELATED TABLES:
1. ct_dv_kham: Update record with actual doctor ID, start time, and preliminary clinical notes.</bpmn:documentation>
      <bpmn:incoming>Flow_To_Exam</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsServices" name="Needs Services (Labs/Imaging)?">
      <bpmn:incoming>Flow_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NoServices</bpmn:outgoing>
      <bpmn:outgoing>Flow_YesServices</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_Gateway" sourceRef="Task_ClinicalExam" targetRef="Gateway_NeedsServices" />
    <bpmn:sequenceFlow id="Flow_NoServices" name="No" sourceRef="Gateway_NeedsServices" targetRef="Task_FinalConclusion" />
    <bpmn:userTask id="Task_OrderServices" name="Order Services (CLS)">
      <bpmn:documentation>RELATED TABLES:
1. ct_bo_chi_dinh: Create header for service order form.
2. ct_dich_vu: Insert individual service line items with prices (linking back to order form).</bpmn:documentation>
      <bpmn:incoming>Flow_YesServices</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Execution</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_YesServices" name="Yes" sourceRef="Gateway_NeedsServices" targetRef="Task_OrderServices" />
    <bpmn:sequenceFlow id="Flow_To_Execution" sourceRef="Task_OrderServices" targetRef="Task_ExecuteService" />
    <bpmn:userTask id="Task_ExecuteService" name="Execute Service &amp; Input Results">
      <bpmn:documentation>RELATED TABLES:
1. ct_dv_ky_thuat: Record technical execution details (performer ID, room ID, timestamps, execution status).
(Note: Financial status remains in ct_dich_vu).</bpmn:documentation>
      <bpmn:incoming>Flow_To_Execution</bpmn:incoming>
      <bpmn:outgoing>Flow_Results_To_Conclusion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Results_To_Conclusion" sourceRef="Task_ExecuteService" targetRef="Task_FinalConclusion" />
    <bpmn:userTask id="Task_FinalConclusion" name="Final Conclusion &amp; Treatment Plan">
      <bpmn:documentation>RELATED TABLES:
1. ct_dv_kham_ket_luan: Record final diagnosis (ICD), treatment direction (discharge/admit), and advice.
2. ct_dot_dieu_tri: Update medical end time.</bpmn:documentation>
      <bpmn:incoming>Flow_NoServices</bpmn:incoming>
      <bpmn:incoming>Flow_Results_To_Conclusion</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Payment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Payment" sourceRef="Task_FinalConclusion" targetRef="Task_ProcessPayment" />
    <bpmn:userTask id="Task_ProcessPayment" name="Process Payment / Checkout">
      <bpmn:documentation>RELATED TABLES:
1. ct_dich_vu: Read outstanding costs, apply insurance/discounts logic, update payment status on lines.
2. ct_phieu_thu: Create financial receipt record for collected amount.
3. ct_dot_dieu_tri: Close financial status of the visit.</bpmn:documentation>
      <bpmn:incoming>Flow_To_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_PatientDischarged" name="Patient Discharged">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_ProcessPayment" targetRef="EndEvent_PatientDischarged" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_HospitalMain">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
